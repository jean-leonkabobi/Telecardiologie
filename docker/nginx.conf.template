# Gabarit nginx du frontend.
#
# Les `${...}` sont développés au démarrage du conteneur par `envsubst`, via le
# point d'entrée de l'image nginx officielle. Deux réglages seulement :
# `API_UPSTREAM` et `MAX_UPLOAD_SIZE`.
#
# **`API_UPSTREAM` est le seul réglage qui compte pour joindre l'API**, et c'est
# une variable d'**exécution** du conteneur frontend. Deux formes selon le
# déploiement :
#
#   API_UPSTREAM=http://backend:8000                  # conteneur voisin, même réseau
#   API_UPSTREAM=https://backend.mon-domaine.com      # API publiée sur son domaine
#
# Les variables `VITE_*` ne jouent aucun rôle ici : `VITE_API_TARGET` ne sert qu'au
# serveur de développement de Vite, et `VITE_API_BASE_URL` est délibérément vidée
# à la compilation pour que le navigateur appelle `/api` en relatif — c'est ce
# relais qui doit ensuite trouver l'API. Les renseigner sans corriger
# `API_UPSTREAM` laisse nginx sur son défaut et produit un 502 accompagné de
# « backend could not be resolved » dans son journal.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Le nom de l'API est résolu à chaque requête et non une fois au démarrage.
    # Sans cela, un redéploiement du backend changerait son adresse IP et nginx
    # continuerait d'appeler l'ancienne jusqu'à son propre redémarrage.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # --- Compression ---------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        application/javascript
        application/json
        image/svg+xml
        text/css
        text/plain;

    # --- En-têtes de sécurité ------------------------------------------------
    #
    # Pas de `Content-Security-Policy` ici : SweetAlert2 et Emotion injectent des
    # styles en ligne, une politique stricte casserait l'interface. Elle mérite
    # d'être posée, mais après avoir relevé les directives réellement
    # nécessaires — une CSP écrite au hasard finit désactivée.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # --- Relais vers l'API ---------------------------------------------------
    location /api/ {
        # Variable et non littéral : c'est ce qui force nginx à utiliser le
        # `resolver` ci-dessus au lieu de figer l'adresse au démarrage.
        #
        # `$request_uri` est repris explicitement : dès que la cible est une
        # variable, nginx cesse de recomposer le chemin depuis le `location`.
        # L'omettre enverrait toutes les requêtes sur la racine de l'API.
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream$request_uri;

        proxy_http_version 1.1;

        # --- Nom d'hôte transmis à l'API -------------------------------------
        #
        # `$proxy_host` — le nom de la cible — et non `$host`, le nom demandé par
        # le navigateur. La distinction est sans effet quand l'API est un conteneur
        # voisin, mais décisive quand elle est publiée sur son propre domaine :
        # derrière un mandataire (Coolify, Cloudflare), c'est l'en-tête `Host` qui
        # désigne l'application à servir. Envoyer celui du frontend faisait
        # chercher le frontend, pas l'API.
        proxy_set_header Host $proxy_host;

        # Nom de serveur transmis dans la poignée de main TLS.
        #
        # Indispensable dès que `API_UPSTREAM` est en `https://` : sans SNI, un
        # mandataire mutualisé ne sait pas quel certificat présenter et la
        # connexion échoue avant la première requête. Sans effet en `http://`.
        proxy_ssl_server_name on;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # L'API déclare `app.set('trust proxy', 1)` : c'est ce qui lui permet de
        # lire l'adresse réelle du client dans `X-Forwarded-For` et de
        # l'enregistrer au journal d'audit. Sans cet en-tête, chaque entrée
        # porterait l'adresse du conteneur nginx — inutile pour une enquête.
        #
        # Le flag `secure` du cookie, lui, dépend de `NODE_ENV`, pas du schéma.
        proxy_set_header X-Forwarded-Proto $scheme;
        # Le nom vu par le navigateur, que l'API ne peut plus déduire de `Host`.
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";

        # Le dépôt d'un tracé peut atteindre la limite métier de 20 Mo. La valeur
        # par défaut de nginx est de 1 Mo : sans ce réglage, toute soumission un
        # peu lourde serait refusée par le relais avec un 413, avant même
        # d'atteindre l'API et son message d'erreur explicite.
        client_max_body_size ${MAX_UPLOAD_SIZE};

        # L'analyse s'exécute en arrière-plan, mais la soumission elle-même
        # attend le téléversement vers le stockage objet.
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # --- Chemins cachés -------------------------------------------------------
    #
    # `/.env`, `/.git/config` et compagnie sont sondés en permanence par des
    # robots — le journal en porte la trace. Aucun de ces fichiers n'existe dans
    # l'image, mais le repli monopage leur répondait `200` avec `index.html` : un
    # scanner l'interprète comme « le chemin existe » et insiste. Un 404 sec coupe
    # court, et sépare le bruit du reste du journal.
    location ~ /\. {
        deny all;
        return 404;
    }

    # --- Fichiers statiques --------------------------------------------------
    #
    # Vite préfixe les noms d'une empreinte de contenu : un fichier donné ne
    # change jamais, il est donc immuable et peut être gardé un an.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # Les polices viennent de `public/` : leur nom ne porte pas d'empreinte de
    # contenu, elles ne peuvent donc pas être déclarées immuables — remplacer un
    # fichier laisserait les navigateurs sur l'ancienne version pendant un an. Un
    # mois est un bon compromis : la police ne change jamais en pratique, et une
    # correction reste diffusable.
    location /fonts/ {
        expires 30d;
        add_header Cache-Control "public" always;
        try_files $uri =404;
    }

    # `index.html` ne doit jamais être mis en cache : c'est lui qui pointe vers
    # les empreintes des fichiers, et une version périmée servirait
    # indéfiniment l'ancienne application après un déploiement.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # --- Repli de l'application monopage -------------------------------------
    #
    # `wouter` gère les routes côté client : un rechargement sur `/analyze/:id`
    # doit renvoyer `index.html`, sinon le navigateur reçoit un 404 alors que la
    # page existe.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
