# Configuration du frontend. Copier en `.env` si besoin de surcharger.
# Les secrets (base de données, JWT, Resend) appartiennent au backend :
# voir telecardiologie-backend/.env.example

# Cible du proxy Vite en développement.
VITE_API_TARGET=http://localhost:8000

# Origine de l'API. Vide = appels relatifs servis par le proxy (recommandé).
# À renseigner seulement pour viser une API sur une autre origine, qui devra
# alors figurer dans le CORS_ORIGINS du backend.
VITE_API_BASE_URL=
